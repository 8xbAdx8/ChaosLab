diff --git a/nsexec_handshake_test.go b/nsexec_handshake_test.go
new file mode 100644
--- /dev/null
+++ b/nsexec_handshake_test.go
@@ -0,0 +1,46 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestResumeHandshake(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "nsexec-test")
+	if out, err := exec.Command("gcc", "-O2", "-o", binary, "nsexec.c").CombinedOutput(); err != nil {
+		t.Fatalf("compile: %v %s", err, out)
+	}
+	for i := 0; i < 50; i++ {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		// No namespace flags: only a harmless command in this test container.
+		c := exec.CommandContext(ctx, binary, "-s", "-t", fmt.Sprint(os.Getpid()), "--", "/bin/true")
+		if err := c.Start(); err != nil {
+			cancel()
+			t.Fatal(err)
+		}
+		ready := false
+		for ctx.Err() == nil {
+			comm, _ := os.ReadFile(fmt.Sprintf("/proc/%d/comm", c.Process.Pid))
+			if strings.TrimSpace(string(comm)) == "pause" {
+				ready = true
+				break
+			}
+			time.Sleep(time.Millisecond)
+		}
+		if ready {
+			_ = c.Process.Signal(syscall.SIGCONT)
+		}
+		err := c.Wait()
+		cancel()
+		if !ready || err != nil {
+			t.Fatalf("iteration %d: ready=%v err=%v", i, ready, err)
+		}
+	}
+}
