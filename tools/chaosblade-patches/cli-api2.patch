diff --git a/cli/cmd/recovery_command.go b/cli/cmd/recovery_command.go
new file mode 100644
--- /dev/null
+++ b/cli/cmd/recovery_command.go
@@ -0,0 +1,35 @@
+package cmd
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strconv"
+)
+
+var recoveryUID = regexp.MustCompile(`^[0-9a-f]{16,64}$`)
+
+func recoveryCommand(seconds uint64, uid string) (*exec.Cmd, error) {
+	executable, err := os.Executable()
+	if err != nil {
+		return nil, err
+	}
+	executable, err = filepath.EvalSymlinks(executable)
+	if err != nil {
+		return nil, err
+	}
+	return recoveryCommandFor(executable, seconds, uid)
+}
+
+func recoveryCommandFor(executable string, seconds uint64, uid string) (*exec.Cmd, error) {
+	if !filepath.IsAbs(executable) || seconds == 0 || !recoveryUID.MatchString(uid) {
+		return nil, fmt.Errorf("invalid recovery identity or delay")
+	}
+	// All dynamic values are positional arguments, never shell source. Preserve
+	// the upstream detached timer for now; this is not a durable recovery service.
+	return exec.Command("/bin/sh", "-c",
+		`nohup /bin/sh -c 'sleep "$1"; exec "$2" destroy "$3"' chaoslab-recovery "$1" "$2" "$3" >/dev/null 2>&1 &`,
+		"chaoslab-launch", strconv.FormatUint(seconds, 10), executable, uid), nil
+}
diff --git a/cli/cmd/recovery_command_test.go b/cli/cmd/recovery_command_test.go
new file mode 100644
--- /dev/null
+++ b/cli/cmd/recovery_command_test.go
@@ -0,0 +1,77 @@
+package cmd
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+)
+
+// Executes only a fake script in a temporary directory. No Docker or Blade
+// command is executed, and no real recovery is claimed by this test.
+func TestRecoveryTimerExecutesExactCandidate(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "candidate 'quoted' with spaces")
+	if err := os.Mkdir(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	output := filepath.Join(dir, "receipt")
+	t.Setenv("CHAOSLAB_TEST_RECEIPT", output)
+	candidate := filepath.Join(dir, "blade-chaoslab-api2")
+	if err := os.WriteFile(candidate, []byte("#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$CHAOSLAB_TEST_RECEIPT\"\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	// A sibling named blade must never be selected by the timer.
+	if err := os.WriteFile(filepath.Join(dir, "blade"), []byte("#!/bin/sh\nprintf wrong > \"$CHAOSLAB_TEST_RECEIPT\"\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	c, err := recoveryCommandFor(candidate, 2, "0123456789abcdef")
+	if err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	if err := c.Run(); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(6 * time.Second)
+	for time.Now().Before(deadline) {
+		data, err := os.ReadFile(output)
+		if err == nil && len(data) > 0 {
+			if string(data) != "destroy\n0123456789abcdef\n" {
+				t.Fatalf("wrong invocation: %q", data)
+			}
+			if time.Since(start) < 1900*time.Millisecond {
+				t.Fatal("timer fired too early")
+			}
+			return
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+	t.Fatal("timer failed to execute candidate within deadline")
+}
+
+func TestRecoveryUsesCandidateAsArgument(t *testing.T) {
+	name := "/tmp/candidate with 'quotes'/blade-chaoslab-api2"
+	uid := "0123456789abcdef"
+	c, err := recoveryCommandFor(name, 10, uid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(c.Args[3:], []string{"chaoslab-launch", "10", name, uid}) {
+		t.Fatalf("unexpected arguments: %q", c.Args)
+	}
+}
+
+func TestRecoveryRejectsInvalidIdentity(t *testing.T) {
+	for _, uid := range []string{"", "abc;id", "../target", "0123456789ABCDEF"} {
+		if _, err := recoveryCommandFor("/tmp/blade", 10, uid); err == nil {
+			t.Fatalf("accepted %q", uid)
+		}
+	}
+	if _, err := recoveryCommandFor("blade", 10, "0123456789abcdef"); err == nil {
+		t.Fatal("accepted relative executable")
+	}
+	if _, err := recoveryCommandFor("/tmp/blade", 0, "0123456789abcdef"); err == nil {
+		t.Fatal("accepted zero delay")
+	}
+}
