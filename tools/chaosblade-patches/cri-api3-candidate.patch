+package exec
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+type targetProcessIdentity struct{ startTime, cgroup string }
+
+func processStartTime(stat string) (string, error) {
+	end := strings.LastIndex(stat, ") ")
+	if end < 0 {
+		return "", fmt.Errorf("invalid process stat")
+	}
+	fields := strings.Fields(stat[end+2:])
+	// fields starts at field 3 (state); starttime is field 22.
+	if len(fields) < 20 || fields[0] == "Z" || fields[0] == "X" {
+		return "", fmt.Errorf("target not live")
+	}
+	if _, err := strconv.ParseUint(fields[19], 10, 64); err != nil {
+		return "", fmt.Errorf("invalid start time")
+	}
+	return fields[19], nil
+}
+
+func readTargetIdentity(pid int32) (targetProcessIdentity, error) {
+	if pid <= 0 {
+		return targetProcessIdentity{}, fmt.Errorf("invalid target pid")
+	}
+	base := fmt.Sprintf("/proc/%d/", pid)
+	before, err := os.ReadFile(base + "stat")
+	if err != nil {
+		return targetProcessIdentity{}, err
+	}
+	start, err := processStartTime(string(before))
+	if err != nil {
+		return targetProcessIdentity{}, err
+	}
+	group, err := os.ReadFile(base + "cgroup")
+	if err != nil || len(group) == 0 {
+		return targetProcessIdentity{}, fmt.Errorf("target cgroup unavailable")
+	}
+	after, err := os.ReadFile(base + "stat")
+	if err != nil {
+		return targetProcessIdentity{}, err
+	}
+	end, err := processStartTime(string(after))
+	if err != nil || start != end {
+		return targetProcessIdentity{}, fmt.Errorf("target changed during identity read")
+	}
+	return targetProcessIdentity{start, string(group)}, nil
+}
+
+func recheckTargetIdentity(pid int32, expected targetProcessIdentity) error {
+	actual, err := readTargetIdentity(pid)
+	if err != nil {
+		return err
+	}
+	if expected.startTime == "" || actual != expected {
+		return fmt.Errorf("target identity changed")
+	}
+	return nil
+}
