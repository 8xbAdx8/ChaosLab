+//go:build linux
+
+package exec
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+func TestTargetIdentityRecheck(t *testing.T) {
+	pid := int32(os.Getpid())
+	identity, err := readTargetIdentity(pid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := recheckTargetIdentity(pid, identity); err != nil {
+		t.Fatal(err)
+	}
+	changed := identity
+	changed.startTime = "0"
+	if err := recheckTargetIdentity(pid, changed); err == nil {
+		t.Fatal("accepted changed start time")
+	}
+	changed = identity
+	changed.cgroup = "different"
+	if err := recheckTargetIdentity(pid, changed); err == nil {
+		t.Fatal("accepted changed cgroup")
+	}
+}
+
+func TestTargetExitRejected(t *testing.T) {
+	c := exec.Command("/bin/sleep", "30")
+	if err := c.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if c.ProcessState == nil {
+			_ = c.Process.Kill()
+			_ = c.Wait()
+		}
+	}()
+	identity, err := readTargetIdentity(int32(c.Process.Pid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = c.Process.Kill()
+	_ = c.Wait()
+	if err := recheckTargetIdentity(int32(c.Process.Pid), identity); err == nil {
+		t.Fatal("accepted exited target")
+	}
+}
+
+func TestProcessStatParsing(t *testing.T) {
+	fields := append([]string{"S"}, strings.Fields(strings.Repeat("0 ", 18))...)
+	fields = append(fields, "12345")
+	value, err := processStartTime("123 (name with ) spaces) " + strings.Join(fields, " "))
+	if err != nil || value != "12345" {
+		t.Fatalf("%q %v", value, err)
+	}
+	for _, text := range []string{"", "broken", "1 (a) Z", "1 (a) S invalid"} {
+		if _, err := processStartTime(text); err == nil {
+			t.Fatal("accepted invalid stat")
+		}
+	}
+}
