+package docker
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/docker/docker/api/types/container"
+)
+
+func TestNegotiatedContainerList(t *testing.T) {
+	for _, version := range []string{"1.40", "1.51", "1.56"} {
+		t.Run(version, func(t *testing.T) {
+			t.Setenv("DOCKER_API_VERSION", "")
+			var listPath string
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/_ping" {
+					w.Header().Set("API-Version", version)
+					w.WriteHeader(http.StatusOK)
+					return
+				}
+				listPath = r.URL.Path
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte("[]"))
+			}))
+			defer srv.Close()
+			c, err := checkAndCreateClient(srv.URL, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			_, err = c.ContainerList(context.Background(), container.ListOptions{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := version
+			if version == "1.56" {
+				want = "1.51"
+			}
+			if listPath != "/v"+want+"/containers/json" {
+				t.Fatalf("unexpected negotiated request: %s", listPath)
+			}
+		})
+	}
+}
+
+func TestHandshakeFailureDoesNotReturnClient(t *testing.T) {
+	for _, mode := range []string{"http-error", "missing-version"} {
+		t.Run(mode, func(t *testing.T) {
+			t.Setenv("DOCKER_API_VERSION", "")
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if !strings.HasSuffix(r.URL.Path, "/_ping") {
+					t.Errorf("unexpected request: %s", r.URL.Path)
+				}
+				if mode == "http-error" {
+					http.Error(w, "unavailable", http.StatusServiceUnavailable)
+					return
+				}
+				w.WriteHeader(http.StatusOK)
+			}))
+			defer srv.Close()
+			c, err := checkAndCreateClient(srv.URL, nil)
+			if err == nil || c != nil {
+				t.Fatalf("failed handshake returned client: %v, %v", c, err)
+			}
+		})
+	}
+}
diff --git a/exec/handshake_guard_linux.go b/exec/handshake_guard_linux.go
new file mode 100644
--- /dev/null
+++ b/exec/handshake_guard_linux.go
@@ -0,0 +1,60 @@
+//go:build linux
+
+package exec
+
+import (
+	"context"
+	"fmt"
+	"os/exec"
+	"syscall"
+	"time"
+)
+
+func waitForHelperState(ctx context.Context, pid int, want string) error {
+	ticker := time.NewTicker(time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		comm, err := getProcessComm(pid)
+		if err != nil {
+			return err
+		}
+		if comm == want {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-ticker.C:
+		}
+	}
+}
+
+// Reaps the direct helper and kills its dedicated process group when verified.
+// Descendants that changed group/session are outside this limited guarantee.
+func cleanupFailedHelper(command *exec.Cmd) error {
+	if command.Process == nil || command.ProcessState != nil {
+		return nil
+	}
+	var groupErr error
+	if command.SysProcAttr != nil && command.SysProcAttr.Setpgid && command.SysProcAttr.Pgid == 0 {
+		pid := command.Process.Pid
+		pgid, err := syscall.Getpgid(pid)
+		if err != nil || pgid != pid {
+			groupErr = fmt.Errorf("helper process group identity unconfirmed")
+		} else if err := syscall.Kill(-pgid, syscall.SIGKILL); err != nil && err != syscall.ESRCH {
+			groupErr = fmt.Errorf("helper process group termination failed: %w", err)
+		}
+	}
+	_ = command.Process.Kill()
+	done := make(chan error, 1)
+	go func() { done <- command.Wait() }()
+	select {
+	case <-done:
+		return groupErr // Reaping alone does not confirm escaped descendants.
+	case <-time.After(2 * time.Second):
+		return fmt.Errorf("helper reap unconfirmed")
+	}
+}
diff --git a/exec/handshake_guard_linux_test.go b/exec/handshake_guard_linux_test.go
