+++ b/exec/handshake_guard_linux_test.go
@@ -0,0 +1,93 @@
+//go:build linux
+
+package exec
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestCleanupDedicatedHelperGroup(t *testing.T) {
+	receipt := filepath.Join(t.TempDir(), "child-pid")
+	c := exec.Command("/bin/sh", "-c", `sleep 30 & echo $! > "$1"; wait`, "fixture", receipt)
+	c.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	if err := c.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if c.ProcessState == nil {
+			_ = cleanupFailedHelper(c)
+		}
+	}()
+	deadline := time.Now().Add(2 * time.Second)
+	child := 0
+	for time.Now().Before(deadline) {
+		data, _ := os.ReadFile(receipt)
+		child, _ = strconv.Atoi(strings.TrimSpace(string(data)))
+		if child > 0 {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if child <= 0 {
+		t.Fatal("child did not start")
+	}
+	if group, err := syscall.Getpgid(child); err != nil || group != c.Process.Pid {
+		t.Fatal("child not in dedicated group")
+	}
+	if err := cleanupFailedHelper(c); err != nil {
+		t.Fatal(err)
+	}
+	deadline = time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", child))
+		if os.IsNotExist(err) {
+			return
+		}
+		end := strings.LastIndex(string(data), ") ")
+		if end >= 0 && strings.HasPrefix(string(data)[end+2:], "Z ") {
+			return
+		} // stopped, orphan reaping belongs to PID 1
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("same-group descendant still running")
+}
+
+func TestHandshakeTimeoutAndReap(t *testing.T) {
+	c := exec.Command("/bin/sleep", "30")
+	if err := c.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if c.ProcessState == nil {
+			_ = cleanupFailedHelper(c)
+		}
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	if err := waitForHelperState(ctx, c.Process.Pid, "pause\n"); err == nil {
+		t.Fatal("accepted unready helper")
+	}
+	if err := cleanupFailedHelper(c); err != nil {
+		t.Fatal(err)
+	}
+	if c.ProcessState == nil {
+		t.Fatal("helper not reaped")
+	}
+}
+
+func TestHandshakeMissingProcess(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := waitForHelperState(ctx, -1, "pause\n"); err == nil {
+		t.Fatal("accepted missing process")
+	}
+}
