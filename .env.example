# Example for a local MySQL database. This file is not loaded automatically.
CHAOSLAB_DB_URL=jdbc:mysql://127.0.0.1:3306/chaoslab?serverTimezone=UTC
CHAOSLAB_DB_USERNAME=chaoslab
CHAOSLAB_DB_PASSWORD=replace-with-a-local-password
CHAOSLAB_MAX_ACTIVE_EXECUTIONS=3
# Absolute path to demo-services/binding.py; required only for local Docker Target dry run/start.
CHAOSLAB_DEMO_BINDING_SCRIPT=
# Local-only Prometheus root URL for read-only report observations.
CHAOSLAB_REPORT_PROMETHEUS_URL=http://127.0.0.1:19090
