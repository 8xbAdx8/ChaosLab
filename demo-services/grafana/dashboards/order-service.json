{
  "uid": "chaoslab-order-service",
  "title": "ChaosLab · 订单服务稳态",
  "description": "仅展示本机 Demo 订单接口的观测事实；FakeChaosEngine 不注入真实故障。",
  "tags": ["chaoslab", "demo", "order-service"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "订单请求量（次/秒）",
      "description": "只统计 /orders/{orderId}，不含健康检查、Actuator、/slow 或 /error。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "chaoslab-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"order-service\",uri=\"/orders/{orderId}\"}[$__rate_interval]))", "legendFormat": "订单请求/秒", "range": true}]
    },
    {
      "id": 2,
      "title": "订单 5xx 错误率",
      "description": "无请求时不显示 0%，避免把缺少流量误判为成功。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "chaoslab-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"refId": "A", "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"order-service\",uri=\"/orders/{orderId}\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"order-service\",uri=\"/orders/{orderId}\"}[$__rate_interval]))", "legendFormat": "5xx / 全部订单请求", "range": true}]
    },
    {
      "id": 3,
      "title": "订单 P95 延迟",
      "description": "由 Micrometer 直方图桶估算，不是逐请求精确值。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "chaoslab-prometheus"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"order-service\",uri=\"/orders/{orderId}\"}[$__rate_interval])))", "legendFormat": "P95", "range": true}]
    }
  ]
}
